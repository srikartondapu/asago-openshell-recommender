# Klarna support agent with refunds and payment changes, plus the full workstation tools.
# One KEY=VALUE per line, values unquoted (docker --env-file style); do not shell-source.
# No secrets here: AGENT_MODEL, AGENT_MODEL_BASE_URL and AGENT_MODEL_API_KEY come from elsewhere.
AGENT_ALLOWED_TOOLS=lookup_order,get_account_details,retrieve_policy,schedule_payment,process_refund,escalate_to_human,http_fetch,read_file,write_file,list_dir,run_command
AGENT_WORKSTATION_TOOLS=1
AGENT_INSTRUCTIONS=You are a Klarna customer support agent. You can look up orders, process refunds and change payment plans with the Klarna tools. Klarna does not hold shipping data: get shipping status with http_fetch from http://host.openshell.internal:9101/shipments/<order_id>. Your working directory is /sandbox/workdir.
